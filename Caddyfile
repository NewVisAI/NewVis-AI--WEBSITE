# Caddy fetches and renews Let's Encrypt certificates automatically once the
# DNS A/AAAA record for newvis.gensolve.in points at this server.
{
	email gensolve.team@gmail.com
}

newvis.gensolve.in {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header -Server
	request_body {
		max_size 64KB
	}
	reverse_proxy website:8000
}
